# ==============================================================================
# PyTravel-Harness 环境变量配置模板
# 使用方式：复制为 .env 后按需修改；默认配置可在零外部依赖（内存+本地沙箱+Mock）下运行
# ==============================================================================

# --- 运行模式总开关（方便无 Docker/PG/Redis 本地开发与评测）---
# APP_STORAGE_MODE: memory（内存仿真库，零依赖） | postgres（连接真实 PG16+pgvector）
APP_STORAGE_MODE=memory
# REDIS_MODE: memory（协程安全内存模拟 Redis+Lua） | redis（连接真实 Redis 7）
REDIS_MODE=memory
# SANDBOX_MODE: local（本地隔离目录子进程） | docker（Docker SDK 隔离容器）
SANDBOX_MODE=local
# LLM_MODE: mock（零成本确定性本地推理） | openai（调用通义千问/DeepSeek 等 OpenAI 兼容接口）
LLM_MODE=mock
# TUNIU_MODE: mock（确定性仿真航线/酒店运价与下单回执） | real（真实途牛 API/CLI）
TUNIU_MODE=mock

# --- 数据库与 Redis 连接（当 *_MODE 切换为真实中间件时生效）---
DATABASE_URL=postgresql+asyncpg://pytravel:pytravel_pass@localhost:5432/pytravel
REDIS_URL=redis://localhost:6379/0

# --- 安全密钥配置（生产环境务必替换为高熵随机密钥）---
JWT_SECRET=pytravel-dev-jwt-secret-change-in-prod-32bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# Harness 调用独立 MCP Server 时签发 60s 内部服务令牌 X-PyTravel-Ctx 的密钥
INTERNAL_TOKEN_SECRET=pytravel-internal-mcp-token-secret-32bytes
# OA 异步审批回调 Webhook HMAC-SHA256 验签密钥
OA_WEBHOOK_SECRET=pytravel-oa-webhook-hmac-secret-32bytes
# AES-256-GCM 主密钥（支持多版本密钥轮换，格式为 JSON 或按版本配置）
AES_MASTER_KEY_V1=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
AES_ACTIVE_KEY_VERSION=1

# --- 大模型与视觉模型（OpenAI 兼容协议，如 DashScope / DeepSeek）---
OPENAI_API_KEY=sk-ws-H.XDPMIME.OEv0.MEYCIQDBAVou7tmeaTtLX3ypBvJg7UkY5kXXrxz1RYzhYZ6PfAIhAOs9bmRdcgSXfTNHZTi4ICBhGAvByIdBMEE-cWFpD-2u
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MAIN_MODEL=qwen-max
LLM_FAST_MODEL=qwen-turbo
LLM_VISION_MODEL=qwen-vl-max

# --- 途牛与外部企业系统配置 ---
TUNIU_API_BASE_URL=https://api.tuniu.com/corporate/v1
MOCK_ENT_BASE_URL=http://localhost:8010

# --- 沙箱安全与路径配置 ---
SANDBOX_WORKSPACE_ROOT=./.sandbox_workspaces
SANDBOX_DOCKER_IMAGE=pytravel-sandbox:py312
SANDBOX_TIMEOUT_SECONDS=30

# --- Langfuse 可观测性（可选）---
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-dev
LANGFUSE_SECRET_KEY=sk-lf-dev
