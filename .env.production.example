# ==============================================================================
# PyTravel-Harness 生产环境配置模板（阿里云 2核8G Linux ECS + Docker Compose）
# 使用方式：cp .env.production.example .env  然后填入真实的 OPENAI_API_KEY
# ==============================================================================

# --- 生产级全栈开关 ---
APP_STORAGE_MODE=postgres
REDIS_MODE=redis
SANDBOX_MODE=docker
MCP_MODE=http
LLM_MODE=openai
TUNIU_MODE=mock

# --- 数据库与 Redis（Docker Compose 内网域名）---
POSTGRES_USER=pytravel
POSTGRES_PASSWORD=pytravel_pass
POSTGRES_DB=pytravel
REDIS_PASSWORD=pytravel_redis_pass

# --- 安全密钥（scripts/deploy_ecs.sh 会自动生成随机高熵密钥替换占位符）---
JWT_SECRET=__AUTO_GENERATE__
INTERNAL_TOKEN_SECRET=__AUTO_GENERATE__
OA_WEBHOOK_SECRET=__AUTO_GENERATE__
AES_MASTER_KEY_V1=__AUTO_GENERATE_B64_32__

# --- 云端大模型与视觉模型（阿里云百炼 DashScope / DeepSeek）---
OPENAI_API_KEY=sk-ws-H.XDPMIME.OEv0.MEYCIQDBAVou7tmeaTtLX3ypBvJg7UkY5kXXrxz1RYzhYZ6PfAIhAOs9bmRdcgSXfTNHZTi4ICBhGAvByIdBMEE-cWFpD-2u
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MAIN_MODEL=qwen-max
LLM_FAST_MODEL=qwen-turbo
LLM_VISION_MODEL=qwen-vl-max
EMBEDDING_MODEL=text-embedding-v3

# --- Langfuse 可观测性（如需自部署，启动时加 --profile observability 并改 true）---
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=pk-lf-dev
LANGFUSE_SECRET_KEY=sk-lf-dev
