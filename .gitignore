# ==============================================================================
# PyTravel-Harness Git 忽略规则（防止密钥、虚拟环境与大体积构建产物误入库）
# ==============================================================================

# Python 虚拟环境、缓存与打包产物
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
dist/
build/

# 前端依赖与打包产物
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# 敏感环境变量文件（只保留 .env.example 与 .env.production.example 模板）
.env
.env.local
.env.*.local

# 运行时临时沙箱、评测产物与压缩包
.sandbox_workspaces/
*.tar.gz
*.zip
eval/last_eval_report.json
scripts/seed_truth_summary.json

# 操作系统与编辑器临时文件
.DS_Store
Thumbs.db
.idea/
